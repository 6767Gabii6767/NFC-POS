# Copiază acest fișier ca backend/.env doar când configurezi Stripe Test.
# Cheile Stripe sunt citite exclusiv de backend și nu se publică în frontend.
PORT=4242
FRONTEND_URL=http://localhost:8000/
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opțional: implicit backend/data/nfc-pos.sqlite
# DATABASE_PATH=
